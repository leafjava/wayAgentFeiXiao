# --- Chain mode ---
# mock: in-memory chain (default, no RPC/private key)
# live: connect to Monad Testnet via RPC
TOKENTRUTH_CHAIN_MODE=mock

# --- Monad Testnet ---
MONAD_RPC=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER=https://testnet.monadexplorer.com

# --- Deployer private key (live mode only, 64 hex without 0x) ---
# Get testnet MON: https://testnet.monad.xyz
PRIVATE_KEY=

# --- Contract address (set after `npm run chain:deploy`) ---
DISCLOSURE_REGISTRY_ADDRESS=
NEXT_PUBLIC_PURCHASE_CONTRACT_ADDRESS=

# --- DeepSeek LLM (OpenAI compatible) ---
# Get key: https://platform.deepseek.com
# Leave empty to use deterministic local engine
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=20

# --- App ---
PORT=4000
DATABASE_URL=file:../data/tokentruth.db
